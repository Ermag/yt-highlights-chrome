{
	"manifest_version": 3,
	"name": "Highlights for YouTube",
	"version": "4.1.1",
	"description": "Turn the timestamps in a video's description and comments into clickable chapter markers on the YouTube progress bar.",
	"default_locale": "en",
	"minimum_chrome_version": "111",
	"permissions": ["storage"],
	"icons": {
		"16": "img/icon-16.png",
		"48": "img/icon-48.png",
		"128": "img/icon-128.png"
	},
	"content_scripts": [
		{
			"matches": ["https://www.youtube.com/*"],
			"js": ["page.js"],
			"world": "MAIN",
			"run_at": "document_start"
		},
		{
			"matches": ["https://www.youtube.com/*"],
			"js": ["content.js"],
			"css": ["content.css"],
			"world": "ISOLATED",
			"run_at": "document_end"
		}
	]
}
